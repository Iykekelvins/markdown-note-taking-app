{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"strict": true,
		"noEmit": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src", "drizzle.config.ts"]
}
